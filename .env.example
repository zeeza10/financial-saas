# Copy to .env.local (local web/CLI) and .dev.vars (local Workers).
# NEVER put real staging or production secrets in this file or commit .env.local / .dev.vars.

# Public client configuration (safe for browser bundle)
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key

# API Worker (apps/api) - MUST NOT contain SUPABASE_SERVICE_ROLE_KEY
APP_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
COOKIE_SIGNING_SECRET=replace-with-local-32-byte-random-hex
CSRF_SECRET=replace-with-local-32-byte-random-hex
STORAGE_DRIVER=local

# Jobs Worker (apps/jobs) - separate Worker for cron/queues only
JOBS_SUPABASE_URL=http://127.0.0.1:54321
JOBS_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key

# Cloudflare R2 (when STORAGE_DRIVER=r2)
R2_BUCKET_NAME=financial-saas-local
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Transactional Email (staging/production; local uses Supabase Mailpit/Inbucket)
EMAIL_PROVIDER=local
EMAIL_API_KEY=replace-with-send-only-api-key
EMAIL_FROM_ADDRESS=noreply@example.com
